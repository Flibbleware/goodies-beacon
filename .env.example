# Goodies Beacon configuration. Copy to .env and fill in.
# Every variable below is read and validated by packages/core/src/config.ts; a missing or
# malformed one stops the process at startup and names itself.

# --- Instance ---------------------------------------------------------------
# Public hostname Caddy serves (used for the TLS certificate and email links).
GOODIES_BEACON_HOST=beacon.example.co.uk
# 32 random bytes, base64. Encrypts secrets entered in Settings. Generate with:
#   openssl rand -base64 32
GOODIES_BEACON_SECRET_KEY=change-me
# Which roles this process runs: api | worker | all
ROLE=all
# Optional: makes this a sources-only worker, polling just these sources and taking no other
# jobs. Comma-separated, e.g. vinted. Leave empty for a worker that handles everything.
WORKER_SOURCES=
# Where downscaled listing photos and reference images are stored. /data/media is the container's
# volume; for `pnpm dev` use an absolute path in the repository, e.g. /path/to/goodies-beacon/media.
MEDIA_DIR=/data/media
# Port the API listens on inside the container.
PORT=3000
# One of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# development | test | production. Leave it empty: the image already sets production, where the
# API also serves the built web app, and `pnpm dev` wants the development default. Setting it
# here would only be a way to get it wrong — docker-compose.yml pins production regardless.
NODE_ENV=

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string; the API and workers share one database. docker-compose.yml builds
# its own from the three variables below and ignores this, so what is here is what `pnpm dev` uses
# against compose.dev.yml — and what a remote worker would point at its droplet over Tailscale.
DATABASE_URL=postgres://goodies_beacon:goodies_beacon@localhost:5432/goodies_beacon
# Role the db service is created with, and that DATABASE_URL above connects as.
POSTGRES_USER=goodies_beacon
# Its password. Letters and digits only — docker-compose.yml splices it into DATABASE_URL without
# encoding, so a / or @ breaks the URL. Generate with: openssl rand -hex 24
# Set it before the first `docker compose up`: Postgres only reads it while the data volume is
# empty, so changing it later does not change the password.
POSTGRES_PASSWORD=change-me
# Database created for it.
POSTGRES_DB=goodies_beacon

# --- Backups ----------------------------------------------------------------
# When the nightly pg_dump runs, 24-hour UTC. Pick a quiet hour.
BACKUP_AT=03:30
# How many days of dumps to keep; older ones are pruned after each run.
BACKUP_KEEP_DAYS=14

# --- AI providers (at least one; roles are configured in Settings) ---------
# A key entered in Settings is stored encrypted and takes precedence over the one here; these are
# the instance-wide fallback. Which model each role uses is a Settings field, not an environment
# variable, so a provider can be swapped without a redeploy.
# Anthropic (Claude) API key.
ANTHROPIC_API_KEY=
# OpenAI API key.
OPENAI_API_KEY=
# Google (Gemini) API key.
GOOGLE_GENERATIVE_AI_API_KEY=
# OpenRouter API key, to reach many providers through one account.
OPENROUTER_API_KEY=
# Base URL of a local Ollama server, e.g. http://localhost:11434
OLLAMA_BASE_URL=

# --- Image ------------------------------------------------------------------
# Image tag the droplet runs; docker compose pulls this. deploy.sh rewrites it on every deploy.
# The version and commit that /healthz reports are baked into the image itself as
# GOODIES_BEACON_BUILD_VERSION and GOODIES_BEACON_BUILD_SHA — never set those here, since a
# value in this file overrides the image's and /healthz would then report whatever was typed.
GOODIES_BEACON_VERSION=latest
# Which published image to run, without its tag. The slim one omits Chromium and so cannot poll
# Vinted. Holding the whole reference means a fork can point this at any registry.
#   ghcr.io/flibbleware/goodies-beacon        full
#   ghcr.io/flibbleware/goodies-beacon/slim   slim
GOODIES_BEACON_IMAGE=ghcr.io/flibbleware/goodies-beacon
# Which Caddyfile to mount. Use ./Caddyfile.tailscale when the host is a *.ts.net name, which
# Let's Encrypt cannot certify.
GOODIES_BEACON_CADDYFILE=./Caddyfile

# --- Spikes (development only) ----------------------------------------------
# Read by spikes/ebay/run.ts (S1-01), not by the application: config.ts never sees these, and
# from P1-04 the adapter takes its eBay credentials from Settings, encrypted at rest. They are
# here because the spike needs somewhere to read them from that is not the repository.
# Which eBay environment the spike talks to: production | sandbox. Sandbox proves the plumbing
# before a production keyset exists; its catalogue is synthetic, so it records no fixtures and
# answers none of S1-01's questions. Default is production.
EBAY_ENV=production
# The "App ID (Client ID)" from https://developer.ebay.com → Application Keys, from the row that
# matches EBAY_ENV above.
EBAY_CLIENT_ID=
# The "Cert ID (Client Secret)" beside it. Production starts PRD-, sandbox SBX-.
EBAY_CLIENT_SECRET=
