# Goodies Beacon configuration. Copy to .env and fill in.
# Every variable below is read and validated by packages/core/src/config.ts; a missing or
# malformed one stops the process at startup and names itself.

# --- Instance ---------------------------------------------------------------
# Public hostname Caddy serves (used for the TLS certificate and email links).
GOODIES_BEACON_HOST=beacon.example.co.uk
# 32 random bytes, base64. Encrypts secrets entered in Settings. Generate with:
#   openssl rand -base64 32
GOODIES_BEACON_SECRET_KEY=change-me
# Which roles this process runs: api | worker | all
ROLE=all
# Optional: makes this a sources-only worker, polling just these sources and taking no other
# jobs. Comma-separated, e.g. vinted. Leave empty for a worker that handles everything.
WORKER_SOURCES=
# Where downscaled listing photos and reference images are stored.
MEDIA_DIR=/data/media
# Port the API listens on inside the container.
PORT=3000
# One of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# development | test | production. The image sets production, where the API also serves the
# built web app; in development Vite serves it and proxies the API.
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string; the API and workers share one database.
DATABASE_URL=postgres://goodies_beacon:goodies_beacon@db:5432/goodies_beacon

# --- AI providers (at least one; roles are configured in Settings) ---------
# Anthropic (Claude) API key.
ANTHROPIC_API_KEY=
# OpenAI API key.
OPENAI_API_KEY=
# Google (Gemini) API key.
GOOGLE_GENERATIVE_AI_API_KEY=
# OpenRouter API key, to reach many providers through one account.
OPENROUTER_API_KEY=
# Base URL of a local Ollama server, e.g. http://localhost:11434
OLLAMA_BASE_URL=

# --- Build identity (baked into the image; override only to correct it) -----
# Image tag the droplet runs. docker compose picks the image with it, and the app reports it
# from /healthz so you can see what is actually running.
GOODIES_BEACON_VERSION=latest
# Commit the image was built from. Set by CI as a build argument; 'unknown' elsewhere.
GOODIES_BEACON_SHA=unknown
