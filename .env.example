# Goodies Beacon configuration. Copy to .env and fill in. Every variable is read and validated
# by packages/core/src/config.ts (P0-04); until then this file documents intent only.

# --- Instance ---------------------------------------------------------------
# Public hostname Caddy serves (used for the TLS certificate and email links).
GOODIES_BEACON_HOST=beacon.example.co.uk
# 32 random bytes, base64. Encrypts secrets entered in Settings. Generate with:
#   openssl rand -base64 32
GOODIES_BEACON_SECRET_KEY=change-me
# Which roles this process runs: api | worker | all
ROLE=all
# Optional: restrict a worker to specific sources, comma-separated (e.g. vinted)
WORKER_SOURCES=
# Where downscaled listing photos and reference images are stored.
MEDIA_DIR=/data/media
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://goodies_beacon:goodies_beacon@db:5432/goodies_beacon

# --- AI providers (at least one; roles are configured in Settings) ---------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=

# --- Deployment (used by scripts/deploy.sh on the droplet) ------------------
GOODIES_BEACON_VERSION=latest
