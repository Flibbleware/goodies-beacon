{
  "name": "@goodies-beacon/core",
  "version": "0.0.0",
  "private": true,
  "description": "Domain types, Zod schemas, database schema and the matching pipeline logic shared by every other package.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. --project @goodies-beacon/core",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "pg-boss": "12.31.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13"
  }
}
