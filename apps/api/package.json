{
  "name": "@goodies-beacon/api",
  "version": "0.0.0",
  "private": true,
  "description": "Hono HTTP server and the shared ROLE-aware entrypoint: authentication, JSON API, interview chat streaming, static serving of the built web app, and the worker subscribers when ROLE includes them.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "test": "vitest run --root ../.. --project @goodies-beacon/api",
    "docs:api": "tsx scripts/generate-api-docs.ts"
  },
  "dependencies": {
    "@goodies-beacon/core": "workspace:*",
    "@goodies-beacon/worker": "workspace:*",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "4.23.13"
  }
}
