{
  "name": "@goodies-beacon/worker",
  "version": "0.0.0",
  "private": true,
  "description": "pg-boss job subscribers: polling source adapters, running the review pipeline, sending notifications, pruning old candidates. Started by the shared entrypoint in apps/api.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. --project @goodies-beacon/worker"
  },
  "dependencies": {
    "@goodies-beacon/ai": "workspace:*",
    "@goodies-beacon/core": "workspace:*",
    "@goodies-beacon/email": "workspace:*",
    "@goodies-beacon/source-ebay": "workspace:*",
    "pg-boss": "12.31.0",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@goodies-beacon/source-template": "workspace:*",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  }
}
